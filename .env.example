# Copy locally to .env. Runtime deployments inject these values into the environment.
# Never commit filled configuration, exports, databases, logs or real example data.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
DISCORD_NOTIFY=true

# Required external PostgreSQL resource. No credentials belong in this example.
DATABASE_URL=
# Optional pg TLS settings: use the team-provided CA and verify-full when needed.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/run/secrets/postgres-ca.pem

# Optional HTTP health endpoints. Omit PORT to disable the listener.
PORT=8080
HOST=0.0.0.0

# Optional Trello task controls and PM. Members do not need Trello accounts.
TASK_CONTROLS_ENABLED=false
TASK_MANAGEMENT_MODE=forum
TASK_MANAGER_ROLE_IDS=
TASK_ALLOWED_CHANNEL_IDS=
TRELLO_BOARD_ID=
TRELLO_API_KEY=
TRELLO_READ_TOKEN=
TRELLO_WRITE_TOKEN=
PM_TRELLO_AUTOMATION_MEMBER_IDS=

# Optional meetings: configure both values to enable.
MEETING_CHANNEL_ID=
MEETING_ROLE_ID=
