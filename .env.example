# Copy locally to .env. Runtime deployments inject these values into the environment.
# Never commit filled configuration, exports, databases, logs or real example data.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
DISCORD_NOTIFY=true

# External MongoDB replica set. Include /database_name in the URI; test is forbidden.
# Credentials stay in environment variables. Set authSource separately when needed.
MONGODB_URI=

# Optional HTTP health endpoints. Omit PORT to disable the listener.
PORT=8080
HOST=0.0.0.0

# Integrated PM runs inside npm start; do not start a separate PM worker.
PM_ENABLED=false
PM_INTERVAL_MS=60000

# Optional Bank task announcements, running in the same Bot process.
# Use the source website's HTTPS root, for example https://bank.example.org.
# Checks run every hour on the hour, regardless of server timezone.
BANK_ENABLED=false
BANK_BASE_URL=
BANK_CHANNEL_ID=

# Optional Trello task controls. Members do not need Trello accounts.
TASK_CONTROLS_ENABLED=false
TASK_MANAGEMENT_MODE=forum
TASK_MANAGER_ROLE_IDS=
# Comma-separated captain/cadre text channels for all task and meeting commands.
# Their Discord permissions authorize members; task manager roles apply only to the forum.
# Leave empty to disable team-channel access.
TASK_ALLOWED_CHANNEL_IDS=
TRELLO_BOARD_ID=
TRELLO_API_KEY=
TRELLO_READ_TOKEN=
TRELLO_WRITE_TOKEN=
PM_TRELLO_AUTOMATION_MEMBER_IDS=

# Optional shared meetings: configure the reminder channel and mentioned role to enable.
# TASK_ALLOWED_CHANNEL_IDS can manage the same meeting and records.
MEETING_CHANNEL_ID=
MEETING_ROLE_ID=
